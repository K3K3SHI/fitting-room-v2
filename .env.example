# Get this from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here
# A long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# (or any random 32+ character string). Changing this logs everyone out.
SESSION_SECRET=replace_with_a_long_random_string

# Where user accounts are stored. On Vercel, linking a Postgres/Neon
# database auto-sets POSTGRES_URL for you — leave this blank in that case.
# For local development, point this at a Postgres instance you control:
#   DATABASE_URL=postgres://user:password@localhost:5432/fitting_room
DATABASE_URL=postgres://user:password@localhost:5432/fitting_room
